{
  "entities": {
    "RepoSnapshot": {
      "title": "RepoSnapshot",
      "description": "A versioned indexing snapshot of a GitHub repository",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "versionTag": { "type": "string" },
        "commitMessage": { "type": "string" },
        "rootUrl": { "type": "string" },
        "defaultBranch": { "type": "string" },
        "prioritizedBranches": { "type": "array" },
        "indexedBranches": { "type": "array" },
        "totalFiles": { "type": "number" },
        "totalSize": { "type": "number" },
        "totalBranches": { "type": "number" },
        "tocSummary": { "type": "string" },
        "googleSheetId": { "type": "string" },
        "googleSheetUrl": { "type": "string" },
        "googleDocId": { "type": "string" },
        "googleDocUrl": { "type": "string" },
        "googleDriveFolderId": { "type": "string" },
        "driveAllResultsUrl": { "type": "string" },
        "agenticContext": { "type": "string" },
        "manifestSummary": { "type": "string" },
        "driveExports": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["owner", "repo", "versionTag", "userId"]
    },
    "RepoFile": {
      "title": "RepoFile",
      "description": "An indexed file from a repository branch",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "branch": { "type": "string" },
        "size": { "type": "number" },
        "type": { "type": "string" },
        "sha": { "type": "string" },
        "category": { "type": "string" },
        "language": { "type": "string" },
        "contentSnippet": { "type": "string" },
        "isReadme": { "type": "boolean" },
        "lineCount": { "type": "number" },
        "snapshotId": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["path", "branch", "snapshotId", "userId"]
    }
  },
  "firestore": {
    "/repo_snapshots/{snapshotId}": {
      "schema": "RepoSnapshot",
      "description": "Collection of versioned repository index snapshots for users"
    },
    "/repo_snapshots/{snapshotId}/files/{fileId}": {
      "schema": "RepoFile",
      "description": "Subcollection of indexed files within a repository snapshot"
    }
  }
}
